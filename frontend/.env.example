# Скопируйте в .env и задайте свои значения

# Режим приложения: preview (данные в localStorage, mock-каталог) или
# production (реальный HTTP к backend). Читается в src/config/app.ts;
# по умолчанию — preview.
VITE_APP_MODE=preview

# URL бэкенда (отдельный домен), например https://api.example.com
# В dev используется и как target прокси /api
BACKEND_URL=http://localhost:8080

# Пароль админ-панели.
# Намеренно БЕЗ префикса VITE_: на Vercel переменные с VITE_ считаются
# конфигом, а не секретом. Пробрасывается в сборку через envPrefix в vite.config.ts
ADMIN_PASSWORD=change-me-admin