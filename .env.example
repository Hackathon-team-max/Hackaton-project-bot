# Скопируйте файл в .env и впишите свой токен:
#   cp .env.example .env
#
# Docker Compose читает .env автоматически и подставляет ${BOT_TOKEN}
# из docker-compose.yml — передавать токен в командах не нужно.
# Файл .env входит в .gitignore и в репозиторий не попадает.
#
# Где взять токен: создайте бота через @TeamMaxBot (или получите токен
# у администратора MAX) — токен нужен для long polling API MAX.
BOT_TOKEN=CHANGE_ME
